# Copie este arquivo para .env (na mesma pasta) se precisar mudar algo.
# Só variáveis com o prefixo VITE_ ficam acessíveis no código do frontend.
# O arquivo .env NÃO deve ser enviado para o Git.

# URL base da API. Deixe vazio para usar o proxy do Vite
# (/api -> http://localhost:8000), que é o recomendado em desenvolvimento.
VITE_API_URL=
